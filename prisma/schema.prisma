generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  admin
  user
}

enum UserStatus {
  active
  blocked
  deleted
}

enum TrailStatus {
  draft
  active
  inactive
  archived
}

enum DifficultyLevel {
  easy
  easy_to_moderate
  moderate
  moderate_to_difficult
  difficult
  expert
}

enum ActivityType {
  hiking
  trekking
  walking
  trail_running
  sightseeing
  other
}

enum RouteFileType {
  gpx
  kmz
  kml
  geojson
  other
}

enum TrailMediaType {
  cover
  route
  gallery
  video
}

enum CostItemType {
  included
  excluded
}

enum SafetyItemType {
  precaution
  required_gear
}

enum RatingBreakdownType {
  count
  percentage
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum RecordingStatus {
  active
  paused
  completed
  abandoned
}

enum HikePoiType {
  viewpoint
  restArea
  waterSource
  campsite
  landmark
  danger
  parking
  trailhead
  junction
  shelter
  bridge
  summit
  other
}

// Models
model User {
  id            BigInt   @id @default(autoincrement())
  fullName      String   @db.VarChar(150)
  email         String   @unique @db.VarChar(255)
  phone         String?  @db.VarChar(30)
  passwordHash  String?  @db.VarChar(255)
  avatarUrl     String?
  role          UserRole @default(user)
  status        UserStatus @default(active)
  emailVerified Boolean  @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  // Relations
  trailReviews  TrailReview[]
  trailFavourites TrailFavourite[]
  auditLogs     AdminAuditLog[]
  hikeSessions  HikeSession[]
  hikeWaypoints HikeWaypoint[]
  hikePhotos    HikeWaypointPhoto[]
  hikeSyncTrackersAsUser HikeSyncTracker[] @relation("HikeSyncTrackerUser")
  hikeSyncTrackersAsOwner HikeSyncTracker[] @relation("HikeSyncTrackerOwner")
  multiDayHikeSyncsAsUser MultiDayHikeSync[] @relation("MultiDayHikeSyncUser")
  multiDayHikeSyncsAsOwner MultiDayHikeSync[] @relation("MultiDayHikeSyncOwner")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
}

model Trail {
  id                    BigInt   @id @default(autoincrement())
  slug                  String   @unique @db.VarChar(180)
  hikeName              String   @db.VarChar(255)
  description           String
  routeFilePath         String?
  routeFileType         RouteFileType?
  maxAltitudeM          Int?
  durationLabel         String?  @db.VarChar(100)
  durationDays          Decimal? @db.Decimal(5, 2)
  difficulty            DifficultyLevel?
  difficultyLabel       String?  @db.VarChar(100)
  difficultyRating      Decimal? @db.Decimal(3, 2)
  activity              ActivityType @default(hiking)
  distanceMinKm         Decimal? @db.Decimal(8, 2)
  distanceMaxKm         Decimal? @db.Decimal(8, 2)
  walkingTimeMinMinutes Int?
  walkingTimeMaxMinutes Int?
  groupSizeLimit        Int?
  entryPermitRequired   Boolean  @default(false)
  fitnessRequirement    String?
  bestTimeNotes         String?
  status                TrailStatus @default(draft)
  sourceUpdatedAt       DateTime?
  publishedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  // Relations
  location              TrailLocation?
  transportation        TrailTransportation?
  ratingSummary         TrailRatingSummary?
  itineraryPhases       ItineraryPhase[]
  highlights            TrailHighlight[]
  pointsOfInterest      PointOfInterest[]
  costItems             TrailCostItem[]
  recommendedSeasons    TrailRecommendedSeason[]
  avoidedMonths         TrailAvoidedMonth[]
  safetyItems           TrailSafetyItem[]
  media                 TrailMedia[]
  reviews               TrailReview[]
  favourites            TrailFavourite[]
  hikeSessions          HikeSession[]
  hikeWaypoints         HikeWaypoint[]

  @@index([slug])
  @@index([status])
  @@index([activity])
  @@index([difficulty])
  @@index([maxAltitudeM])
  @@index([status, activity])
  @@index([status, difficulty])
  @@index([status, publishedAt])
}

model TrailLocation {
  id               BigInt   @id @default(autoincrement())
  trailId          BigInt   @unique
  region           String   @db.VarChar(255)
  country          String   @db.VarChar(100)
  startPoint       String?  @db.VarChar(255)
  endPoint         String?  @db.VarChar(255)
  distanceFromCityKm Decimal? @db.Decimal(8, 2)
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trail            Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@index([trailId])
  @@index([country])
  @@index([region])
  @@index([country, region])
}

model TrailTransportation {
  id             BigInt   @id @default(autoincrement())
  trailId        BigInt   @unique
  privateOption  String?
  publicOption   String?
  returnOption   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trail          Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@index([trailId])
}

model TrailRatingSummary {
  id               BigInt   @id @default(autoincrement())
  trailId          BigInt   @unique
  average          Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount      Int      @default(0)
  breakdownType    RatingBreakdownType @default(count)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trail            Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)
  breakdowns       TrailRatingBreakdown[]

  @@index([trailId])
  @@index([average])
  @@index([reviewCount])
}

model TrailRatingBreakdown {
  id               BigInt   @id @default(autoincrement())
  ratingSummaryId  BigInt
  stars            Int
  value            Int      @default(0)
  createdAt        DateTime @default(now())

  ratingSummary    TrailRatingSummary @relation(fields: [ratingSummaryId], references: [id], onDelete: Cascade)

  @@unique([ratingSummaryId, stars])
  @@index([ratingSummaryId])
  @@index([stars])
}

model ItineraryPhase {
  id              BigInt   @id @default(autoincrement())
  trailId         BigInt
  phaseNumber     Int
  title           String   @db.VarChar(255)
  durationLabel   String?  @db.VarChar(100)
  durationMinutes Int?
  altitudeM       Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)
  details         ItineraryPhaseDetail[]

  @@unique([trailId, phaseNumber])
  @@index([trailId])
}

model ItineraryPhaseDetail {
  id              BigInt   @id @default(autoincrement())
  phaseId         BigInt
  detail          String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  phase           ItineraryPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([phaseId, sortOrder])
  @@index([phaseId])
}

model TrailHighlight {
  id              BigInt   @id @default(autoincrement())
  trailId         BigInt
  text            String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@index([trailId])
}

model PointOfInterest {
  id              BigInt   @id @default(autoincrement())
  trailId         BigInt
  name            String   @db.VarChar(255)
  description     String?
  type            String?  @db.VarChar(50)
  distanceKm      Decimal? @db.Decimal(8, 2)
  icon            String?  @db.VarChar(100)
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  altitudeM       Int?
  images          String[] @default([])
  facilities      String[] @default([])
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@index([trailId])
  @@index([trailId, distanceKm])
}

model TrailCostItem {
  id              BigInt   @id @default(autoincrement())
  trailId         BigInt
  type            CostItemType
  text            String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@unique([trailId, type, sortOrder])
  @@index([trailId])
  @@index([type])
}

model TrailRecommendedSeason {
  id              BigInt   @id @default(autoincrement())
  trailId         BigInt
  season          String   @db.VarChar(50)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@unique([trailId, season])
  @@index([trailId])
  @@index([sortOrder])
}

model TrailAvoidedMonth {
  id              BigInt   @id @default(autoincrement())
  trailId         BigInt
  monthNumber     Int?
  monthLabel      String   @db.VarChar(50)
  reason          String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@unique([trailId, monthLabel])
  @@index([trailId])
  @@index([sortOrder])
}

model TrailSafetyItem {
  id              BigInt   @id @default(autoincrement())
  trailId         BigInt
  type            SafetyItemType
  text            String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@unique([trailId, type, sortOrder])
  @@index([trailId])
  @@index([type])
}

model TrailMedia {
  id              BigInt   @id @default(autoincrement())
  trailId         BigInt
  type            TrailMediaType
  url             String
  altText         String?  @db.VarChar(255)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@index([trailId])
  @@index([type])
  @@index([trailId, type, sortOrder])
}

model TrailReview {
  id              BigInt   @id @default(autoincrement())
  trailId         BigInt
  userId          BigInt
  rating          Int
  title           String?  @db.VarChar(150)
  comment         String?
  status          ReviewStatus @default(pending)
  visitedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trailId])
  @@index([trailId])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@index([trailId, status])
}

model TrailFavourite {
  id              BigInt   @id @default(autoincrement())
  trailId         BigInt
  userId          BigInt
  createdAt       DateTime @default(now())

  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trailId])
  @@index([trailId])
  @@index([userId])
}

model AdminAuditLog {
  id              BigInt   @id @default(autoincrement())
  adminUserId     BigInt
  action          String   @db.VarChar(100)
  entityType      String?  @db.VarChar(80)
  entityId        BigInt?
  oldValue        Json?
  newValue        Json?
  createdAt       DateTime @default(now())

  adminUser       User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model HikeSession {
  id                  String   @id @default(uuid())
  trailId             BigInt
  userId              BigInt
  startTime           DateTime
  endTime             DateTime?
  status              RecordingStatus @default(active)
  isPaused            Boolean  @default(false)
  pausedAt            DateTime?
  totalDistance       Decimal? @db.Decimal(10, 2)
  totalAltitude       Int?
  maxAltitude         Int?
  minAltitude         Int?
  currentAltitude     Int?
  summary             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  trail               Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackPoints         TrackPoint[]
  waypoints           HikeWaypoint[]

  @@index([userId])
  @@index([trailId])
  @@index([status])
  @@index([startTime])
  @@index([userId, startTime])
  @@index([trailId, startTime])
}

model TrackPoint {
  id                  BigInt   @id @default(autoincrement())
  sessionId           String
  latitude            Decimal  @db.Decimal(11, 8)
  longitude           Decimal  @db.Decimal(12, 8)
  elevation           Decimal? @db.Decimal(10, 2)
  accuracy            Decimal? @db.Decimal(7, 2)
  heading             Decimal? @db.Decimal(6, 2)
  speed               Decimal? @db.Decimal(7, 2)
  timestamp           DateTime
  distanceSinceLastPoint Decimal? @db.Decimal(10, 2)
  createdAt           DateTime @default(now())

  session             HikeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestamp])
}

model HikeWaypoint {
  id                  BigInt   @id @default(autoincrement())
  sessionId           String
  trailId             BigInt
  userId              BigInt
  name                String?  @db.VarChar(50)
  description         String?  @db.VarChar(200)
  type                HikePoiType
  latitude            Decimal  @db.Decimal(11, 8)
  longitude           Decimal  @db.Decimal(12, 8)
  elevation           Decimal? @db.Decimal(10, 2)
  facilities          String[] @default([])
  conditions          String?  @db.VarChar(150)
  distanceFromStart   Decimal? @db.Decimal(10, 2)
  durationAtStart     String?
  timestamp           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  session             HikeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trail               Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos              HikeWaypointPhoto[]

  @@index([sessionId])
  @@index([trailId])
  @@index([userId])
  @@index([type])
  @@index([sessionId, timestamp])
}

model HikeWaypointPhoto {
  id                  BigInt   @id @default(autoincrement())
  waypointId          BigInt
  userId              BigInt
  photoUrl            String   @db.VarChar(500)
  thumbnail           String?  @db.VarChar(500)
  latitude            Decimal? @db.Decimal(11, 8)
  longitude           Decimal? @db.Decimal(12, 8)
  elevation           Decimal? @db.Decimal(10, 2)
  metadata            Json?
  timestamp           DateTime
  createdAt           DateTime @default(now())

  waypoint            HikeWaypoint @relation(fields: [waypointId], references: [id], onDelete: Cascade)
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([waypointId])
  @@index([userId])
  @@index([timestamp])
}

// Sync tracking models
enum SyncStatus {
  pending
  uploading
  synced
  failed
  conflict
}

model HikeSyncTracker {
  id                  BigInt   @id @default(autoincrement())
  sessionId           String?  // Optional: link to HikeSession if created
  userId              BigInt
  clientUuid          String   @unique // Stable UUID from client
  ownerUserId         BigInt   // Account that owns the record
  serverId            String?  // Server identity after sync
  localRevision       Int      @default(1)
  syncedRevision      Int?     // Last acknowledged revision
  serverVersion       Int?     // Detect conflicts
  syncStatus          SyncStatus @default(pending)
  lastSyncedAt        DateTime?
  lastSyncError       String?
  multiDayHikeSyncId  BigInt?  // Link to multi-day group if applicable
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User @relation("HikeSyncTrackerUser", fields: [userId], references: [id], onDelete: Cascade)
  ownerUser           User @relation("HikeSyncTrackerOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  multiDayHike        MultiDayHikeSync? @relation(fields: [multiDayHikeSyncId], references: [id], onDelete: SetNull)
  jobRecords          SyncJobRecord[]
  mediaMapping        SyncMediaMapping[]

  @@unique([ownerUserId, clientUuid])
  @@index([userId])
  @@index([ownerUserId])
  @@index([syncStatus])
  @@index([lastSyncedAt])
  @@index([multiDayHikeSyncId])
}

model SyncMediaMapping {
  id                  BigInt   @id @default(autoincrement())
  hikeSyncTrackerId   BigInt
  localPath           String   @db.VarChar(500)
  clientMediaUuid     String   // Stable UUID for the media
  serverMediaId       String?  // After upload
  serverMediaUrl      String?  @db.VarChar(500)
  mediaChecksum       String?  @db.VarChar(64) // SHA256
  uploadStatus        SyncStatus @default(pending)
  mediaType           String   // cover, route, gallery, poi
  waypointClientUuid  String?  // If linked to waypoint
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  hikeSyncTracker     HikeSyncTracker @relation(fields: [hikeSyncTrackerId], references: [id], onDelete: Cascade)

  @@index([hikeSyncTrackerId])
  @@index([clientMediaUuid])
  @@index([uploadStatus])
}

model SyncJobRecord {
  id                  BigInt   @id @default(autoincrement())
  hikeSyncTrackerId   BigInt
  status              SyncStatus @default(pending)
  revision            Int      // Revision being synced
  idempotencyKey      String   @unique // clientUuid:revision
  uploadedAt          DateTime?
  completedAt         DateTime?
  error               String?
  createdAt           DateTime @default(now())

  hikeSyncTracker     HikeSyncTracker @relation(fields: [hikeSyncTrackerId], references: [id], onDelete: Cascade)

  @@index([hikeSyncTrackerId])
  @@index([status])
  @@index([revision])
}

model MultiDayHikeSync {
  id                  BigInt   @id @default(autoincrement())
  userId              BigInt
  clientUuid          String   @unique
  ownerUserId         BigInt
  serverId            String?
  name                String   @db.VarChar(255)
  description         String?
  status              String   @default("active") @db.VarChar(50)
  localRevision       Int      @default(1)
  syncedRevision      Int?
  serverVersion       Int?
  syncStatus          SyncStatus @default(pending)
  lastSyncedAt        DateTime?
  lastSyncError       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User @relation("MultiDayHikeSyncUser", fields: [userId], references: [id], onDelete: Cascade)
  owner               User @relation("MultiDayHikeSyncOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  sessions            HikeSyncTracker[] // Sessions that are part of this multi-day group

  @@unique([ownerUserId, clientUuid])
  @@index([userId])
  @@index([ownerUserId])
  @@index([syncStatus])
}